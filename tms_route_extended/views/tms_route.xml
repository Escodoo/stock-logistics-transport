<odoo>
    <record model="ir.ui.view" id="tms_route_form_view">
        <field name="model">tms.route</field>
        <field name="inherit_id" ref="tms.view_tms_route_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Parâmetros">
                    <group>
                        <group name="general" string="General Information">
                            <field name="region_type" />
                            <field name="freight_type" />
                            <field name="has_delivery_restriction" />
                            <field
                                name="restriction_note"
                                attrs="{'invisible': [('has_delivery_restriction', '=', False)]}"
                            />
                            <field name="enabled_pickup" />
                        </group>
                        <group name="deadlines" string="Deadlines and Quantities">
                            <field name="delivery_deadline" />
                            <field name="toll_quantity" />
                        </group>
                        <group name="values" string="Values">
                            <field name="additional_cost" />
                            <field name="delivery_value" />
                        </group>
                        <group name="commercial" string="Commercial Information">
                            <field name="commercial_area" />
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

